node_modules/
.pnpm-store/

# TypeScript build output
dist/
*.tsbuildinfo

# Generated schema output is committed on purpose: `pnpm run generate:check`
# regenerates it and fails on any diff, which is how CI catches both a stale
# schema and a hand-edited generated file. See scripts/check-generated.mjs.

