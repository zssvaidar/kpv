{
  "name": "kpv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "kpv monorepo: pnpm workspace for the TypeScript packages plus one Go module for the agent",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kpv/web run dev",
    "generate": "node scripts/generate-schema.mjs",
    "generate:check": "node scripts/check-generated.mjs",
    "test": "pnpm run test:ts && pnpm run test:go",
    "test:ts": "vitest run",
    "test:go": "cd agent && go test ./...",
    "typecheck": "pnpm run typecheck:ts && pnpm run typecheck:go",
    "typecheck:ts": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "typecheck:go": "cd agent && go vet ./...",
    "lint": "pnpm run lint:ts && pnpm run lint:format && pnpm run lint:go",
    "lint:ts": "eslint .",
    "lint:format": "prettier --check .",
    "lint:go": "cd agent && golangci-lint run --config ../.golangci.yml ./...",
    "build": "pnpm run generate && pnpm run build:ts && pnpm run build:go",
    "build:ts": "pnpm -r run build",
    "build:go": "cd agent && go build ./...",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "16.0.0",
    "json-schema-to-zod": "2.8.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
