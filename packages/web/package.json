{
  "name": "@kpv/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "kpv web front end: the Vite + React shell, its typed agent client and the development proxy",
  "scripts": {
    "dev": "node dev/dev.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@kpv/schema": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
