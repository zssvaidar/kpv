      }
    ]
  },
  "removed": {
    "valid": [
      {
        "name": "one",
        "why": "One snapshot removed.",
        "body": {
          "root": "/home/user/code",
          "snapshot": "20261122T101500Z-0a1b2c3d"
        }
      }
    ],
    "invalid": [
      {
        "name": "no-snapshot",
        "why": "snapshot is required.",
        "body": {
          "root": "/r"
        }
      }
    ]
  },
  "errors": {
    "valid": [
      {
        "name": "changed",
        "why": "The review is out of date.",
        "body": {
          "error": "changed",
          "message": "what is staged changed since the review was drawn, or a directory on the way changed, so nothing was written; look at the review again"
        }
      },
      {
        "name": "drift",
        "why": "Every differing file is listed.",
        "body": {
          "error": "drift",
          "message": "some project files are not what was staged from, so nothing was written",
          "drift": [
            {
              "path": "src/a.py",
              "now": "changed"
            },
            {
              "path": "src/b.py",
              "now": "link"
            }
          ]
        }
      },
      {
        "name": "root-unavailable",
        "why": "A root that is gone says why.",
        "body": {
          "error": "rootUnavailable",
          "message": "this project directory is unavailable, so nothing was written",
          "reason": "notFound"
        }
      },
      {
        "name": "unavailable",
        "why": "No config directory.",
        "body": {
          "error": "unavailable",
          "message": "the agent has no config directory, so it keeps no staged changes and applies none"
        }
      }
    ],
    "invalid": [
      {
        "name": "unknown-kind",
        "why": "error is one of the listed kinds.",
        "body": {
          "error": "nope",
          "message": "x"
        }
      },
      {
        "name": "unknown-drift-state",
        "why": "A drift's now is one of the listed states.",
        "body": {
          "error": "drift",
          "message": "x",
          "drift": [
            {
              "path": "a",
              "now": "fine"
            }
          ]
        }
      },
      {
        "name": "no-message",
        "why": "message is required.",
        "body": {
          "error": "io"
        }
      }
    ]
  },
  "pairingViolations": {
