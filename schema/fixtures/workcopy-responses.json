              "root": "/r",
              "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "files": 1,
              "available": false,
              "reason": "notFound",
              "rootReason": "notFound"
            }
          ],
          "unreadable": 0
        }
      }
    ],
