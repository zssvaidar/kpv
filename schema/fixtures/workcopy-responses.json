{
  "$comment": "The one set of working-copy endpoint fixtures (#43). Both toolchains read this file: agent/internal/httpapi/workcopies_fixtures_test.go and packages/schema/src/workcopy-fixtures.test.ts. Never copy it per language. lists are WorkcopyList answers (GET /api/workcopies), reviews WorkcopyReview answers (GET /api/workcopies/review), revisionRequests the apply and discard bodies, snapshotRequests the restore and snapshot removal bodies, reports WorkcopyReport answers, discarded WorkcopyDiscarded answers, removed WorkcopySnapshotRemoved answers, errors WorkcopyError answers. The pairings the schema states in words are held by both tests: a valid fixture keeps them, and each case in pairingViolations passes the schema and breaks one.",
  "lists": {
    "valid": [
      {
        "name": "empty",
        "why": "No working copies.",
        "body": {
          "copies": [],
          "unreadable": 0
        }
      },
      {
        "name": "one-available-one-gone",
        "why": "One working copy whose pipeline is listed and one whose root is unavailable, and one store that was moved aside.",
        "body": {
          "copies": [
            {
              "root": "/home/user/code",
              "directory": "orders",
              "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "files": 2,
              "available": true
            },
            {
              "root": "/home/user/gone",
              "revision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "files": 1,
              "available": false,
              "reason": "rootUnavailable",
              "rootReason": "notFound"
            }
          ],
          "unreadable": 1
        }
      }
    ],
    "invalid": [
      {
        "name": "no-unreadable",
        "why": "unreadable is required.",
        "body": {
          "copies": []
        }
      },
      {
        "name": "zero-files",
        "why": "A working copy holds at least one file.",
        "body": {
          "copies": [
            {
              "root": "/r",
              "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "files": 0,
              "available": true
            }
          ],
          "unreadable": 0
        }
      },
      {
        "name": "bad-revision",
        "why": "A revision is 32 lowercase hex digits.",
        "body": {
          "copies": [
            {
              "root": "/r",
              "revision": "XYZ",
              "files": 1,
              "available": true
            }
          ],
          "unreadable": 0
        }
      }
    ]
  },
  "reviews": {
    "valid": [
      {
        "name": "nothing-staged",
        "why": "An opened pipeline with nothing staged has no revision.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "files": [],
          "unreadable": false,
          "snapshots": []
        }
      },
      {
        "name": "every-change",
        "why": "Added, modified with CRLF, deleted, and a drifted file with no texts; one snapshot.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "files": [
            {
              "path": "pipeline.yaml",
              "change": "modified",
              "state": "ready",
              "baseText": "id: orders\n",
              "stagedText": "id: orders\nname: Orders\n"
            },
            {
              "path": "src/empty.py",
              "change": "added",
              "state": "ready",
              "stagedText": ""
            },
            {
              "path": "src/main.py",
              "change": "modified",
              "state": "ready",
              "baseText": "a\r\nb\r\n",
              "stagedText": "a\r\nb"
            },
            {
              "path": "src/old.py",
              "change": "deleted",
              "state": "ready",
              "baseText": "old\n"
            },
            {
              "path": "src/x.bin",
              "change": "modified",
              "state": "notText"
            }
          ],
          "unreadable": false,
          "snapshots": [
            {
              "id": "20261122T101500Z-0a1b2c3d",
              "taken": "2026-11-22T10:15:00Z",
              "paths": ["src/main.py"]
            }
          ]
        }
      },
      {
        "name": "unreadable-store",
        "why": "The stored working copy could not be read.",
        "body": {
          "root": "/home/user/orders",
          "files": [],
          "unreadable": true,
          "snapshots": []
        }
      }
    ],
    "invalid": [
      {
        "name": "unknown-state",
        "why": "state is one of the listed values.",
        "body": {
          "root": "/r",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "files": [
            {
              "path": "a",
              "change": "added",
              "state": "weird"
            }
          ],
          "unreadable": false,
          "snapshots": []
        }
      },
      {
        "name": "bad-path",
        "why": "A staged path follows the source path pattern.",
        "body": {
          "root": "/r",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "files": [
            {
              "path": "/etc/passwd",
              "change": "added",
              "state": "ready",
              "stagedText": ""
            }
          ],
          "unreadable": false,
          "snapshots": []
        }
      },
      {
        "name": "bad-snapshot-id",
        "why": "A snapshot id is a UTC second and eight hex digits.",
        "body": {
          "root": "/r",
          "files": [],
          "unreadable": false,
          "snapshots": [
            {
              "id": "x",
              "taken": "2026-11-22T10:15:00Z",
              "paths": ["a"]
            }
          ]
        }
      },
      {
        "name": "missing-snapshots",
        "why": "snapshots is required.",
        "body": {
          "root": "/r",
          "files": [],
          "unreadable": false
        }
      }
    ]
  },
  "revisionRequests": {
    "valid": [
      {
        "name": "in-a-directory",
        "why": "Apply or discard a pipeline in a directory.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      {
        "name": "root-pipeline",
        "why": "A root that is the pipeline sends no directory.",
        "body": {
          "root": "/home/user/orders",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    ],
    "invalid": [
      {
        "name": "no-revision",
        "why": "revision is required.",
        "body": {
          "root": "/r"
        }
      },
      {
        "name": "empty-directory",
        "why": "An empty directory is refused; leave it out.",
        "body": {
          "root": "/r",
          "directory": "",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      {
        "name": "extra-field",
        "why": "Nothing else is taken.",
        "body": {
          "root": "/r",
          "revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "force": true
        }
      }
    ]
  },
  "snapshotRequests": {
    "valid": [
      {
        "name": "restore",
        "why": "Restore or remove one snapshot.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "snapshot": "20261122T101500Z-0a1b2c3d"
        }
      }
    ],
    "invalid": [
      {
        "name": "path-as-id",
        "why": "A snapshot id is never a path.",
        "body": {
          "root": "/r",
          "snapshot": "../../x"
        }
      }
    ]
  },
  "reports": {
    "valid": [
      {
        "name": "complete",
        "why": "Every path written.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "snapshot": "20261122T101500Z-0a1b2c3d",
          "complete": true,
          "files": [
            {
              "path": "src/a.py",
              "result": "written"
            },
            {
              "path": "src/b.py",
              "result": "written"
            }
          ]
        }
      },
      {
        "name": "partway",
        "why": "The second write failed; the third was not written.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "snapshot": "20261122T101500Z-0a1b2c3d",
          "complete": false,
          "files": [
            {
              "path": "src/a.py",
              "result": "written"
            },
            {
              "path": "src/b.py",
              "result": "failed",
              "kind": "io"
            },
            {
              "path": "src/c.py",
              "result": "notWritten"
            }
          ]
        }
      },
      {
        "name": "restore",
        "why": "A restore with a file the apply never wrote.",
        "body": {
          "root": "/home/user/orders",
          "snapshot": "20261122T101500Z-0a1b2c3d",
          "complete": true,
          "files": [
            {
              "path": "src/a.py",
              "result": "written"
            },
            {
              "path": "src/b.py",
              "result": "unchanged"
            }
          ]
        }
      }
    ],
    "invalid": [
      {
        "name": "no-files",
        "why": "A report names at least one path.",
        "body": {
          "root": "/r",
          "snapshot": "20261122T101500Z-0a1b2c3d",
          "complete": true,
          "files": []
        }
      },
      {
        "name": "unknown-result",
        "why": "result is one of the listed values.",
        "body": {
          "root": "/r",
          "snapshot": "20261122T101500Z-0a1b2c3d",
          "complete": true,
          "files": [
            {
              "path": "a",
              "result": "maybe"
            }
          ]
        }
      }
    ]
  },
  "discarded": {
    "valid": [
      {
        "name": "three",
        "why": "Three staged files discarded.",
        "body": {
          "root": "/home/user/code",
          "directory": "orders",
          "discarded": 3
        }
      }
