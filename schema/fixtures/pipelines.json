{
  "$comment": "The one set of pipeline fixtures. Both toolchains read this file: agent/internal/pipeline/fixtures_test.go and packages/schema/src/fixtures.test.ts. Never copy it per language. Each invalid case states the failures it expects as a pair of JSON Pointers: instanceLocation into the document, keywordLocation into schema/pipeline.schema.json. Both sides require every stated failure to be reported, which is how they are held to the same outcome. The stated failures are the ones the case is about; a validator may report further consequences of the same mistake.",
  "valid": [
    {
      "name": "source-and-destination-only",
      "why": "A source and a destination alone is a legal pipeline, so processingSteps may be absent entirely.",
      "pipeline": {
        "id": "orders-to-billing",
        "language": "python",
        "source": {
          "id": "orders",
          "type": "kafkaSource",
          "topic": "orders.v1"
        },
        "destination": {
          "id": "billing",
          "type": "kafkaDestination",
          "topic": "billing.v1"
        },
        "runtimeConfiguration": { "networkMode": "docker" }
      }
    },
    {
      "name": "zero-processing-steps",
      "why": "The same pipeline written with an explicit empty list of steps.",
      "pipeline": {
        "id": "orders-to-billing",
        "language": "typescript",
        "source": {
          "id": "orders",
          "type": "kafkaSource",
          "topic": "orders.v1"
        },
        "processingSteps": [],
        "destination": {
          "id": "billing",
          "type": "kafkaDestination",
          "topic": "billing.v1"
        },
        "runtimeConfiguration": { "networkMode": "docker" }
      }
    },
    {
      "name": "every-block-type",
      "why": "One of each block in the plan's block table, in pipeline order, with and without a custom-code reference.",
      "pipeline": {
        "id": "orders-enriched",
        "language": "go",
        "source": {
          "id": "orders",
          "type": "kafkaSource",
          "topic": "orders.v1",
          "consumerGroupId": "kpv-orders-enriched",
          "autoOffsetReset": "earliest",
          "messageFormat": "json"
        },
        "processingSteps": [
          {
            "id": "only-paid",
            "type": "filter",
            "configuration": { "expression": "status == 'paid'" }
          },
          {
            "id": "to-billing-shape",
            "type": "transform",
            "configuration": {
              "mappings": [
                { "targetField": "amount", "expression": "order.total" },
                { "targetField": "customer", "expression": "order.customer.id" }
              ],
              "dropUnmappedFields": true
            }
          },
          {
            "id": "require-amount",
            "type": "validate",
            "configuration": {
              "rules": [
                { "field": "amount", "required": true, "fieldType": "number" }
              ],
              "onInvalid": "deadLetter",
              "deadLetterTopic": "billing.invalid.v1"
            }
          },
          {
            "id": "apply-discounts",
            "type": "customCode",
            "configuration": {
              "entrypoint": "apply_discounts",
              "timeoutMs": 2000
            },
            "customCode": {
              "path": "src/discounts.go",
              "symbol": "ApplyDiscounts"
            }
          }
        ],
        "destination": {
          "id": "billing",
          "type": "kafkaDestination",
          "topic": "billing.v1",
          "acks": "all",
          "preserveKey": true,
          "messageFormat": "json"
        },
        "runtimeConfiguration": {
          "networkMode": "host",
          "envFile": "config/.env.local",
          "environmentVariableNames": ["KAFKA_PASSWORD", "BILLING_API_TOKEN"],
          "logLevel": "debug"
        }
      }
    },
    {
      "name": "repeated-step-type-distinct-ids",
      "why": "Two steps of the same type are fine; it is the identifiers that have to differ.",
      "pipeline": {
        "id": "orders-filtered-twice",
        "language": "python",
        "source": {
          "id": "orders",
          "type": "kafkaSource",
          "topic": "orders.v1"
        },
        "processingSteps": [
          {
            "id": "only-paid",
            "type": "filter",
            "configuration": { "expression": "status == 'paid'" }
          },
          {
            "id": "only-large",
            "type": "filter",
            "configuration": {
              "expression": "order.total > 100",
              "keepOnMatch": true
            }
          }
        ],
        "destination": {
          "id": "billing",
          "type": "kafkaDestination",
          "topic": "billing.v1"
        },
        "runtimeConfiguration": { "networkMode": "docker", "logLevel": "warn" }
      }
    },
    {
      "name": "custom-code-step-without-reference",
      "why": "The custom-code reference is optional on every step, including a custom-code step whose file is not written yet.",
      "pipeline": {
        "id": "orders-custom",
        "language": "typescript",
        "source": {
          "id": "orders",
          "type": "kafkaSource",
          "topic": "orders.v1"
