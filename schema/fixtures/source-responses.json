          "text": "",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "generated": false
        }
      },
      {
        "name": "no-generated",
        "why": "generated is required.",
        "body": {
          "root": "/home/user/code",
          "path": "a",
          "text": "",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      {
        "name": "extra-field",
        "why": "Nothing else is carried, a real path least of all.",
