        "body": {
          "root": "/home/user/code",
          "path": "src/main.py",
          "text": "",
          "sha256": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "generated": false
        }
      },
      {
        "name": "absolute-path",
