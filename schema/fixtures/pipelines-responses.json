          "root": "/home/user/code/app",
          "directory": "billing",
          "pipeline": {
            "id": "orders-to-billing",
            "name": "Orders to billing",
            "language": "python",
            "source": {
              "id": "source",
              "type": "kafkaSource",
              "topic": "orders.v1"
            },
            "destination": {
              "id": "destination",
              "type": "kafkaDestination",
              "topic": "billing.v1"
            },
            "runtimeConfiguration": { "networkMode": "docker" }
